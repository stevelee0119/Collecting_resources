# =============================================================================
# DL-RCIS 환경변수 예시 (PRD v2.1 §5.1, §18.3)
#
# 이 파일을 복사해 .env 로 만들고 실제 값을 채우십시오.
#   cp .env.example .env
#
# 경고: .env 는 절대 Git 에 커밋하지 마십시오. (.gitignore 에 등록되어 있습니다)
#       이 예시 파일에는 변수명과 설명만 두고 실제 값은 넣지 않습니다.
#
# 각 값의 발급 절차는 docs/API_발급_연동_가이드.md 를 참고하십시오.
# =============================================================================

# --- 공통 -------------------------------------------------------------------
# Crossref/OpenAlex polite pool 및 Unpaywall 필수 파라미터로 사용됩니다.
CONTACT_EMAIL=

# --- 국내 학술·정책 소스 ------------------------------------------------------
# KCI Open API 키 (OAI-PMH 는 키 없이 사용 가능한지 별도 확인)
KCI_API_KEY=
# RISS Open API — 기관 승인 후 발급
RISS_API_KEY=
# ScienceON / AccessON (KISTI) — client_id 와 token 을 함께 사용합니다.
SCIENCEON_CLIENT_ID=
SCIENCEON_API_KEY=
# NKIS 국가정책연구포털
NKIS_API_KEY=
# 공공데이터포털 인증키 (PRISM 등)
DATA_GO_KR_API_KEY=
# 국가법령정보 공동활용 사용자 식별자(OC) — API Key 가 아니라 식별자입니다.
LAW_GO_KR_OC=

# --- 해외 학술 소스 ----------------------------------------------------------
CORE_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
# OpenAlex — 2026-02-13 부터 API Key 필수 (polite pool/mailto 폐지)
OPENALEX_API_KEY=
DOAJ_API_KEY=
ZENODO_API_KEY=

# --- 이메일 브리핑 -----------------------------------------------------------
DLRCIS_SENDER_EMAIL=
DLRCIS_RECEIVER_EMAIL=
# SMTP 사용 시 — Gmail 은 계정 비밀번호가 아니라 '앱 비밀번호' 입니다.
DLRCIS_SMTP_PASSWORD=
# Gmail API(OAuth 2.0) 사용 시 — 파일 경로만 적습니다.
GMAIL_CLIENT_SECRET_FILE=
GMAIL_TOKEN_FILE=

# --- LLM 요약 (선택) ---------------------------------------------------------
# 미설정 시 자동으로 추출식 요약으로 대체됩니다.
ANTHROPIC_API_KEY=
