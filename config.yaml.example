# 웹 크롤링 및 수집 프로그램 설정 예시 파일 (config.yaml.example)

mode: 1
collection_scope: "all_period_documents"

schedule:
  frequency: "monthly"
  day_of_month: 1
  time: "09:00"

email:
  enabled: true
  smtp_server: "smtp.gmail.com"
  smtp_port: 587
  sender_email: "your_email@gmail.com"
  sender_password: "your_app_password_here"
  receiver_email: "target_user@gmail.com"

crawler:
  max_results_per_institution: 20
  first_run_range:
    start_date: "2026-01-01"
    end_date: "2026-07-31"

essential_institutions:
  academic:
    - name: "PRISM 정책연구관리시스템"
      domain: "prism.go.kr"
    - name: "NKIS 국가정책연구포털"
      domain: "nkis.re.kr"
    - name: "국회입법조사처"
      domain: "nars.go.kr"
    - name: "공공데이터포털"
      domain: "data.go.kr"
    - name: "공공기관 경영정보 알리오"
      domain: "alio.go.kr"
    - name: "RISS 학술연구정보서비스"
      domain: "riss.kr"
    - name: "미 육군 작전법센터"
      domain: "tjaglcs.army.mil"
      url: "https://tjaglcs.army.mil/center/clamo"

  judicial:
    - name: "경찰청"
      domain: "police.go.kr"
    - name: "대검찰청"
      domain: "spo.go.kr"
    - name: "고위공직자범죄수사처"
      domain: "cio.go.kr"
    - name: "대법원"
      domain: "scourt.go.kr"
    - name: "사법연수원"
      domain: "jti.scourt.go.kr"
    - name: "사법정책연구원"
      domain: "jpri.scourt.go.kr"
    - name: "법무연수원"
      domain: "ioj.go.kr"
    - name: "한국형사·법무정책연구원"
      domain: "kicj.re.kr"

  defense:
    - name: "미 육군 작전법센터 (CLAMO)"
      domain: "tjaglcs.army.mil"
      url: "https://tjaglcs.army.mil/center/clamo"
    - name: "한국국방연구원 (KIDA)"
      domain: "kida.re.kr"

  extended:
    - name: "교육부"
      domain: "moe.go.kr"
    - name: "고용노동부"
      domain: "moel.go.kr"
    - name: "국가인권위원회"
      domain: "humanrights.go.kr"

domains:
  group_a:
    - "arxiv.org"
    - "aclanthology.org"
    - "rand.org"
    - "mdpi.com"
    - "nber.org"
    - "discover.dtic.mil"
    - "econpapers.repec.org"
    - "doi.org"
    - "tjaglcs.army.mil"
  group_b:
    - "go.kr"
    - "re.kr"
    - "or.kr"
    - "ac.kr"
    - "riss.kr"
    - "kci.go.kr"
    - "ssrn.com"
    - "scholar.google.com"
    - "klri.re.kr"
